# URL base del servidor anime1v-api (sin /api/v1/anime)
# Web: http://localhost:3001
# Emulador Android: http://10.0.2.2:3001
# Dispositivo Android físico: http://<IP-LAN-de-tu-PC>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# API Key configurada en server/.env (API_KEYS)
EXPO_PUBLIC_API_KEY=dev-anime1v-key
